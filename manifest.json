{
  "manifest_version": 3,
  "name": "CleanShield - Ad Blocker & Cleaner",
  "version": "1.1.0",
  "description": "Bloqueur de publicites et nettoyeur de formulaires : nettoie les pages bruitees et revele les bonnes reponses.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://ollama.com/*",
    "https://api.anthropic.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CleanShield"
  }
}